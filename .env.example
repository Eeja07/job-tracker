# Environment configuration template for Job Tracker

NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/job_tracker?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Authentication
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Google OAuth Integration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://job.eeja.fun/api/v1/gmail/callback

# Storage
STORAGE_PROVIDER=LOCAL
UPLOAD_MAX_SIZE_MB=50

# Frontend URL
FRONTEND_URL=https://job.eeja.fun
