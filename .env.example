# Environment configuration template for Job Tracker
# Copy to .env and fill in real values — this file is safe to commit (no secrets)

NODE_ENV=production
PORT=3000

# Postgres (used by docker-compose)
POSTGRES_DB=job_tracker
POSTGRES_USER=jobtracker
POSTGRES_PASSWORD=your_db_password_here
POSTGRES_PORT=5432

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/job_tracker?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Authentication
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Google OAuth Integration (Gmail Sync)
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://job.eeja.fun/api/v1/gmail/callback

# Frontend URL (for OAuth callback redirect)
FRONTEND_URL=https://job.eeja.fun

# WhatsApp Gateway
WA_GATEWAY_URL=http://localhost:3001
WA_GATEWAY_API_KEY=your_wa_gateway_key_here
WA_NOTIFICATION_PHONES=628xxxxxxxxxx

# Docker
API_PORT=3001
